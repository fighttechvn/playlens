{
  "manifest_version": 3,
  "name": "PlayLens – Play Store Downloads, Reviews & Update Dates",
  "short_name": "PlayLens",
  "version": "1.4.0",
  "description": "Show downloads, review count and last-updated date on every app card in Google Play lists (developer / collection / search pages).",
  "permissions": ["storage", "clipboardWrite"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PlayLens settings"
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
