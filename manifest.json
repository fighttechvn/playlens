{
  "manifest_version": 3,
  "name": "PlayLens – App Stats for Google Play",
  "short_name": "PlayLens",
  "version": "2.1.0",
  "description": "App statistics on Google Play lists: exact installs, app age, ratings spread, prices, a watchlist, keyword ideas and CSV export.",
  "permissions": ["storage", "clipboardWrite", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://play.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PlayLens settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/*"],
      "exclude_matches": ["https://play.google.com/console/*"],
      "js": ["core.js", "license.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.google.com/console/*"],
      "js": ["core.js", "console-parse.js", "console.js"],
      "run_at": "document_idle"
    }
  ]
}
